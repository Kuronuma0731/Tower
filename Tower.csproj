<Project Sdk="Godot.NET.Sdk/4.7.1">
  <!--
    Godot 端的 C# 專案：只有表現層與輸入，規則全部來自 Tower.Core。
    Core 不引用 GodotSharp——這條界線就是當年 Unity asmdef 那條，換引擎後照樣成立。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Tower</RootNamespace>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      Godot.NET.Sdk 預設把整個專案樹的 *.cs 都收進來——那會連 src/Tower.Core、
      tools/CoreVerify 以及 obj/ 底下的產生檔一起編，直接撞成重複定義。
      表現層只有 game/，明確指定即可。
    -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="game/**/*.cs" />
    <ProjectReference Include="src/Tower.Core/Tower.Core.csproj" />
  </ItemGroup>
</Project>
